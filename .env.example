# Environment Configuration (Opsional)
# Copy file ini menjadi .env jika ingin customize

# Server
NODE_ENV=development
SERVER_PORT=3000
SERVER_HOST=localhost

# Database
DB_NAME=kopikuba
DB_PATH=./kopikuba.db

# CORS
CORS_ORIGIN=http://localhost:8000

# JWT (untuk future authentication)
JWT_SECRET=kopi-kuba-secret-key-change-this-in-production

# Email (untuk future email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password
