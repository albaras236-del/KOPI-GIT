# Environment Configuration

# Server
NODE_ENV=development
SERVER_PORT=3000
SERVER_HOST=localhost

# Database
DB_NAME=kopikuba
DB_PATH=./kopikuba.db

# CORS
CORS_ORIGIN=http://localhost:8000

# Email Verification (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password

# JWT (untuk future authentication)
JWT_SECRET=kopi-kuba-secret-key-change-this-in-production

# DEMO MODE (Jika tidak ada email config)
DEMO_VERIFICATION_CODE=123456

